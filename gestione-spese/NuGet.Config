<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Disabilita qualsiasi fallback globale di Visual Studio -->
  <fallbackPackageFolders>
    <!-- Nessuna cartella di fallback -->
  </fallbackPackageFolders>

  <!-- Non forziamo globalPackagesFolder: in Docker e nei runner GitHub si usa la cartella di default (~/.nuget/packages), evitando permessi negati su /root/.nuget -->
  <config>
  </config>
</configuration>
